---
/**
 * GitHub-style grid of the last year: one square per day, darker when more posts were published.
 * Built at build time; the daily rebuild (deploy.yml schedule) keeps it current.
 */
import T from "@/components/i18n/T.astro";
import { getAllPosts } from "@/data/post";
import { dateLocales, type Lang } from "@/i18n";
import { buildActivityWeeks } from "@/utils/activity";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const posts = await getAllPosts(lang);
const weeks = buildActivityWeeks(
	posts.map((p) => p.data.publishDate),
	new Date(),
);
const total = weeks.flat().reduce((sum, day) => sum + day.count, 0);

const level = (count: number) =>
	count === 0 ? "bg-global-text/10" : count === 1 ? "bg-accent/45" : count === 2 ? "bg-accent/75" : "bg-accent";
const label = (date: string, count: number) => {
	const day = new Date(`${date}T00:00:00Z`).toLocaleDateString(dateLocales[lang], {
		day: "numeric",
		month: "long",
		year: "numeric",
		timeZone: "UTC",
	});
	if (lang === "fr") return `${day} : ${count} article${count > 1 ? "s" : ""}`;
	return `${day}: ${count} post${count === 1 ? "" : "s"}`;
};
---

<section>
	<h2 class="title mb-2 text-xl"><T fr="Activité" en="Activity" /></h2>
	<p class="text-muted mb-4 text-xs">
		<T
			fr={`${total} article${total > 1 ? "s" : ""} sur les 12 derniers mois`}
			en={`${total} post${total === 1 ? "" : "s"} in the last 12 months`}
		/>
	</p>
	<div class="overflow-x-auto pb-2">
		<div class="grid w-max grid-flow-col grid-rows-7 gap-[3px]" role="img" aria-label={`${total}`}>
			{
				weeks.flat().map((day) => (
					<span class:list={["block h-2.5 w-2.5 rounded-[2px]", level(day.count)]} title={label(day.date, day.count)} />
				))
			}
		</div>
	</div>
</section>
