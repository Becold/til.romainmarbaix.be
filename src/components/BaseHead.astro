---
import { WEBMENTION_PINGBACK, WEBMENTION_URL } from "astro:env/client";
import { defaultLang, type Lang, languages, localize, ogLocales, stripLangPrefix } from "@/i18n";
import { siteConfig } from "@/site.config";
import type { SiteMeta } from "@/types";
import "@/styles/global.css";

type Props = SiteMeta & {
	lang: Lang;
	/** URL of each language version of the page; hreflang is emitted when there are at least two */
	alternates?: Partial<Record<Lang, string>> | undefined;
};

const {
	articleDate,
	articleModifiedDate,
	articleTags,
	alternates,
	description: rawDescription = siteConfig.description,
	lang = defaultLang,
	noindex = false,
	ogImage,
	title: rawTitle,
} = Astro.props;

// Server-rendered meta is in the language of the page content.
const title = localize(rawTitle, lang);
const description = localize(rawDescription, lang);

const titleSeparator = "•";
const siteTitle = `${title} ${titleSeparator} ${siteConfig.title}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(ogImage ? ogImage : "/social-card.png", Astro.site).href;

const altLangs = alternates ? languages.filter((l) => alternates[l]) : [];
const altPaths = altLangs.length > 1 ? alternates : undefined;

const author = { "@type": "Person", name: siteConfig.author, url: Astro.site?.href };
const jsonLd = articleDate
	? {
			"@context": "https://schema.org",
			"@type": "BlogPosting",
			headline: title,
			description,
			inLanguage: lang,
			datePublished: articleDate,
			dateModified: articleModifiedDate ?? articleDate,
			author,
			image: socialImageURL,
			keywords: articleTags?.join(", "),
			mainEntityOfPage: canonicalURL.href,
			url: canonicalURL.href,
		}
	: stripLangPrefix(Astro.url.pathname) === "/"
		? {
				"@context": "https://schema.org",
				"@type": "WebSite",
				name: siteConfig.title,
				description,
				inLanguage: lang,
				url: canonicalURL.href,
				author,
			}
		: null;
---

<meta charset="utf-8" />
<meta content="width=device-width, initial-scale=1.0" name="viewport" />
<title>{siteTitle}</title>
{noindex && <meta content="noindex, follow" name="robots" />}

{/* Icons */}
<link href="/icon.svg" rel="icon" type="image/svg+xml" />
{
	import.meta.env.PROD && (
		<>
			{/* Favicon & Apple Icon, Generated at build */}
			<link rel="icon" href="/favicon-32x32.png" type="image/png" />
			<link href="/icons/apple-touch-icon.png" rel="apple-touch-icon" />
			{/* Manifest */}
			<link href="/manifest.webmanifest" rel="manifest" />
		</>
	)
}

{/* Canonical URL */}
{!noindex && <link href={canonicalURL} rel="canonical" />}
{
	altPaths && (
		<>
			{altLangs.map((l) => (
				<link href={new URL(altPaths[l]!, Astro.site)} hreflang={l} rel="alternate" />
			))}
			{altPaths[defaultLang] && (
				<link href={new URL(altPaths[defaultLang], Astro.site)} hreflang="x-default" rel="alternate" />
			)}
		</>
	)
}

{/* Primary Meta Tags */}
<meta content={description} name="description" />
<meta content={siteConfig.author} name="author" />

{/* Open Graph / Facebook */}
<meta content={articleDate ? "article" : "website"} property="og:type" />
<meta content={title} property="og:title" />
<meta content={description} property="og:description" />
<meta content={canonicalURL} property="og:url" />
<meta content={siteConfig.title} property="og:site_name" />
<meta content={ogLocales[lang]} property="og:locale" />
{altPaths && altLangs.filter((l) => l !== lang).map((l) => <meta content={ogLocales[l]} property="og:locale:alternate" />)}
<meta content={socialImageURL} property="og:image" />
<meta content="1200" property="og:image:width" />
<meta content="630" property="og:image:height" />
{
	articleDate && (
		<>
			<meta content={siteConfig.author} property="article:author" />
			<meta content={articleDate} property="article:published_time" />
			{articleModifiedDate && <meta content={articleModifiedDate} property="article:modified_time" />}
			{articleTags?.map((tag) => <meta content={tag} property="article:tag" />)}
		</>
	)
}

{/* Twitter */}
<meta content="summary_large_image" name="twitter:card" />
<meta content={title} name="twitter:title" />
<meta content={description} name="twitter:description" />
<meta content={socialImageURL} name="twitter:image" />

{/* Structured data */}
{jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

{/* Sitemap */}
<link href="/sitemap-index.xml" rel="sitemap" />

{/* RSS auto-discovery */}
<link href={`/${lang}/rss.xml`} title="TIL" rel="alternate" type="application/rss+xml" />
<link href={`/${lang}/notes/rss.xml`} title="Notes" rel="alternate" type="application/rss+xml" />

{/* Webmentions */}
{
	WEBMENTION_URL && (
		<>
			<link href={WEBMENTION_URL} rel="webmention" />
			{WEBMENTION_PINGBACK && <link href={WEBMENTION_PINGBACK} rel="pingback" />}
		</>
	)
}

<meta content={Astro.generator} name="generator" />
