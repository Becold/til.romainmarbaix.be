---
import type { CollectionEntry } from "astro:content";
import type { HTMLTag, Polymorphic } from "astro/types";
import FormattedDate from "@/components/FormattedDate.astro";
import T from "@/components/i18n/T.astro";
import { postUrl } from "@/data/post";

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> & {
	post: CollectionEntry<"post">;
	withDesc?: boolean;
};

const { as: Tag = "div", post, withDesc = false } = Astro.props;
---

<FormattedDate class="text-muted min-w-30 font-semibold" date={post.data.publishDate} />
<Tag data-post-lang={post.data.lang}>
	{post.data.draft && <span class="text-red-500">(<T fr="Brouillon" en="Draft" />) </span>}
	<span class="text-muted me-1 text-xs font-semibold" title={post.data.lang === "fr" ? "Français" : "English"}
		>[{post.data.lang}]</span
	>
	<a class="cactus-link" href={postUrl(post)} lang={post.data.lang}>
		{post.data.title}
	</a>
</Tag>
{withDesc && <q class="line-clamp-3 italic">{post.data.description}</q>}
