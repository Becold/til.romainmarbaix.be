---
import BaseHead from "@/components/BaseHead.astro";
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import LangProvider from "@/components/i18n/LangProvider.astro";
import SkipLink from "@/components/SkipLink.astro";
import ThemeProvider from "@/components/ThemeProvider.astro";
import { defaultLang, localize } from "@/i18n";
import { siteConfig } from "@/site.config";
import type { SiteMeta } from "@/types";

interface Props {
	meta: SiteMeta;
}

const { meta } = Astro.props;
// monolingual pages (/ and /en/) fix the UI language; posts and notes leave it to the reader
const uiFixed = Astro.locals.uiLang !== undefined;
const lang = Astro.locals.uiLang ?? meta.lang ?? defaultLang;
const title = meta.title;
// tab title in each UI language, applied client side by LangProvider (search engines read the server-rendered one)
const titleFr = `${localize(title, "fr")} • ${siteConfig.title}`;
const titleEn = `${localize(title, "en")} • ${siteConfig.title}`;
---

<html
	class="scroll-smooth"
	lang={lang}
	data-ui-lang={lang}
	data-ui-fixed={uiFixed ? "" : undefined}
	data-title-fr={titleFr}
	data-title-en={titleEn}
>
	<head>
		<BaseHead {...meta} lang={lang} alternates={uiFixed} />
		<LangProvider />
		<ThemeProvider />
	</head>
	<body
		class="bg-global-bg text-global-text mx-auto flex min-h-screen max-w-3xl flex-col px-4 pt-16 font-mono text-sm font-normal antialiased sm:px-8"
	>
		<SkipLink />
		<Header />
		<main id="main">
			<slot />
		</main>
		<Footer />
		<script is:inline type="speculationrules">
			{
				"prefetch": [
					{
						"where": {
							"href_matches": "/*"
						},
						"eagerness": "immediate"
					}
				],
				"prerender": [
					{
						"where": {
							"href_matches": "/*"
						},
						"eagerness": "moderate"
					}
				]
			}
		</script>
	</body>
</html>
