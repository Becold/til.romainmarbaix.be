---
import { type CollectionEntry, render } from "astro:content";

import Masthead from "@/components/blog/Masthead.astro";
import T from "@/components/i18n/T.astro";
import TOC from "@/components/blog/TOC.astro";
import PostEnhancements from "@/components/blog/PostEnhancements.astro";
import PostNav from "@/components/blog/PostNav.astro";
import RelatedPosts from "@/components/blog/RelatedPosts.astro";
import SeriesBox from "@/components/blog/SeriesBox.astro";
import TranslationLink from "@/components/i18n/TranslationLink.astro";
import { getAllPosts, getPostTranslations } from "@/data/post";
import { siteConfig } from "@/site.config";
import { getGitLastModified } from "@/utils/git";
import { getAdjacentPosts, getRelatedPosts, getSeries } from "@/utils/postNav";
import WebMentions from "@/components/blog/webmentions/index.astro";

import BaseLayout from "./Base.astro";

interface Props {
	post: CollectionEntry<"post">;
}

const { post } = Astro.props;
const { ogImage, title, description, updatedDate, publishDate, lang, tags } = post.data;
const socialImage = ogImage ?? `/og-image/${post.id}.png`;
const { headings, remarkPluginFrontmatter } = await render(post);
const readingMinutes: number = remarkPluginFrontmatter.readingMinutes;
// The whole page is in the language the post is written in.
Astro.locals.uiLang = lang;
// Other language versions, linked through `translationKey` (hreflang, FR/EN switch).
const translations = await getPostTranslations(post);
Astro.locals.alternates = translations;

// Last update: frontmatter `updatedDate`, else the last git commit of the file; shown only if after the publish day
const sourcePath = post.filePath?.replaceAll("\\", "/");
const candidate = updatedDate ?? (sourcePath ? getGitLastModified(sourcePath) : undefined);
const dayOf = (d: Date) => d.toISOString().slice(0, 10);
const lastUpdated = candidate && dayOf(candidate) > dayOf(publishDate) ? candidate : undefined;
const editUrl = sourcePath ? `${siteConfig.repoUrl}/blob/${siteConfig.repoBranch}/${sourcePath}` : undefined;

// Navigation within the posts of the same language
const siblings = await getAllPosts(lang);
const related = getRelatedPosts(post, siblings);
const { previous, next } = getAdjacentPosts(post, siblings);
const series = getSeries(post, siblings);
---

<BaseLayout
	meta={{
		articleDate: publishDate.toISOString(),
		articleModifiedDate: lastUpdated?.toISOString(),
		articleTags: tags,
		description,
		lang,
		ogImage: socialImage,
		title,
	}}
>
	<article class="grow break-words" data-pagefind-body>
		<div id="blog-hero" class="mb-12">
			<Masthead content={post} readingMinutes={readingMinutes} updatedDate={lastUpdated} />
			<TranslationLink lang={lang} translations={translations} />
			<SeriesBox series={series} current={post} />
		</div>
		<div class="flex flex-col gap-10 lg:flex-row lg:items-start lg:justify-between">
			{!!headings.length && <TOC headings={headings} />}
			<div
				class="prose prose-sm prose-headings:font-semibold prose-headings:text-accent-2 prose-headings:before:absolute prose-headings:before:-ms-4 prose-headings:before:text-muted prose-headings:hover:before:text-accent sm:prose-headings:before:content-['#'] sm:prose-th:before:content-none"
			>
				<slot />
				<WebMentions />
			</div>
		</div>
		<footer data-pagefind-ignore>
			{
				editUrl && (
					<p class="mt-10 text-sm">
						<a class="cactus-link" href={editUrl} rel="noreferrer" target="_blank">
							<T fr="Modifier sur GitHub" en="Edit on GitHub" />
						</a>
					</p>
				)
			}
			<PostNav previous={previous} next={next} />
			<RelatedPosts posts={related} />
		</footer>
	</article>
	<PostEnhancements />
	<button
		class="hover:border-link fixed end-4 bottom-8 z-90 flex h-10 w-10 translate-y-28 cursor-pointer items-center justify-center rounded-full border-2 border-transparent bg-zinc-200 text-3xl opacity-0 transition-all transition-discrete duration-300 data-[show=true]:translate-y-0 data-[show=true]:opacity-100 sm:end-8 sm:h-12 sm:w-12 dark:bg-zinc-700"
		data-show="false"
		id="to-top-btn"
	>
		<span class="sr-only"><T fr="Retour en haut" en="Back to top" /></span>
		<svg
			aria-hidden="true"
			class="h-6 w-6"
			fill="none"
			focusable="false"
			stroke="currentColor"
			stroke-width="2"
			viewBox="0 0 24 24"
			xmlns="http://www.w3.org/2000/svg"
		>
			<path d="M4.5 15.75l7.5-7.5 7.5 7.5" stroke-linecap="round" stroke-linejoin="round"></path>
		</svg>
	</button>
</BaseLayout>

<script>
	const scrollBtn = document.getElementById("to-top-btn") as HTMLButtonElement;
	const targetHeader = document.getElementById("blog-hero") as HTMLDivElement;

	function callback(entries: IntersectionObserverEntry[]) {
		entries.forEach((entry) => {
			// only show the scroll to top button when the heading is out of view
			scrollBtn.dataset.show = (!entry.isIntersecting).toString();
		});
	}

	scrollBtn.addEventListener("click", () => {
		document.documentElement.scrollTo({ behavior: "smooth", top: 0 });
	});

	const observer = new IntersectionObserver(callback);
	observer.observe(targetHeader);
</script>
