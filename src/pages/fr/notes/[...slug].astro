---
import { getCollection } from "astro:content";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import TranslationLink from "@/components/i18n/TranslationLink.astro";
import Note from "@/components/note/Note.astro";
import { getNoteTranslations } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";

// notes written in this language only
export const getStaticPaths = (async () => {
	const notes = await getCollection("note", ({ data }) => data.lang === "fr");
	return notes.map((note) => ({
		params: { slug: note.id },
		props: { note },
	}));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { note } = Astro.props;
// The whole page is in the language the note is written in; other versions linked through `translationKey`.
Astro.locals.uiLang = note.data.lang;
const translations = await getNoteTranslations(note);
Astro.locals.alternates = translations;

const meta = {
	description: note.data.description || note.data.title,
	lang: note.data.lang,
	title: note.data.title,
};
---

<PageLayout meta={meta}>
	<Note as="h1" note={note} />
	<TranslationLink lang={note.data.lang} translations={translations} />
</PageLayout>
