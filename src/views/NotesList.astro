---
import type { Lang } from "@/i18n";
import T from "@/components/i18n/T.astro";
import type { CollectionEntry } from "astro:content";
import type { Page } from "astro";
import { Icon } from "astro-icon/components";
import Note from "@/components/note/Note.astro";
import Pagination from "@/components/Paginator.astro";
import PageLayout from "@/layouts/Base.astro";

interface Props {
	lang: Lang;
	page: Page<CollectionEntry<"note">>;
}

const { lang, page } = Astro.props;
// Monolingual page: <T>, dates and links render only in this language (see src/i18n.ts)
Astro.locals.uiLang = lang;

const meta = {
	lang,
	description: { fr: "Notes courtes", en: "Short notes" },
	title: "Notes",
};

const paginationProps = {
	...(page.url.prev && {
		prevUrl: {
			text: { fr: "← Page précédente", en: "← Previous page" },
			url: page.url.prev,
		},
	}),
	...(page.url.next && {
		nextUrl: {
			text: { fr: "Page suivante →", en: "Next page →" },
			url: page.url.next,
		},
	}),
};
---

<PageLayout meta={meta}>
	<section>
		<h1 class="title mb-12 flex items-center gap-3">
			Notes <a class="text-accent" href="/notes/rss.xml" target="_blank">
				<span class="sr-only"><T fr="Flux RSS" en="RSS feed" /></span>
				<Icon aria-hidden="true" class="h-6 w-6" focusable="false" name="mdi:rss" />
			</a>
		</h1>
		<ul class="mt-6 space-y-8 text-start">
			{
				page.data.map((note) => (
					<li class="">
						<Note note={note} as="h2" isPreview />
					</li>
				))
			}
		</ul>
		<Pagination {...paginationProps} />
	</section>
</PageLayout>
