---
/**
 * Sends the reader to a random post of this language. The list of URLs is built at build time.
 * noindex, excluded from the sitemap (astro.config.ts).
 */
import T from "@/components/i18n/T.astro";
import { getAllPosts, postUrl } from "@/data/post";
import { type Lang, localizePath } from "@/i18n";
import PageLayout from "@/layouts/Base.astro";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
// Monolingual page: <T>, dates and links render only in this language (see src/i18n.ts)
Astro.locals.uiLang = lang;

const urls = (await getAllPosts(lang)).map(postUrl);

const meta = {
	lang,
	noindex: true,
	title: { fr: "Un article au hasard", en: "Random post" },
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-6"><T fr="Un article au hasard" en="Random post" /></h1>
	<p>
		{
			urls.length > 0 ? (
				<T fr="Redirection vers un article au hasard…" en="Taking you to a random post…" />
			) : (
				<T fr="Aucun article pour l'instant." en="No posts yet." />
			)
		}
		<a class="cactus-link ms-1" href={localizePath("/posts/", lang)}>
			<T fr="Voir tous les articles" en="See all posts" />
		</a>
	</p>
	<script is:inline define:vars={{ urls }}>
		if (urls.length > 0) location.replace(urls[Math.floor(Math.random() * urls.length)]);
	</script>
</PageLayout>
